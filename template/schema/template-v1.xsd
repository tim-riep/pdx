<?xml version="1.0" encoding="UTF-8"?>
<!--
  pdx template format 1 (template.xml).

  A template describes a document independently of the data: page masters,
  subforms, fields with bindings to the data XSD, tables with header, footer,
  subtotals and carry-overs, styles, format patterns per locale and text
  resources per language. The compiler translates it into XSLT 3.0, which
  generates XSL-FO.

  Every element carries a stable ID. The designer and error messages refer to
  it. Bindings are XPath expressions relative to the context of the enclosing
  element (initially the root of the data).

  Format 1 has the same content as format 0 up to pdx 0.1.0 (namespace
  https://pdx.example/ns/template/0). pdx still reads old templates.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="https://github.com/tim-riep/pdx/ns/template/1"
           targetNamespace="https://github.com/tim-riep/pdx/ns/template/1"
           elementFormDefault="qualified">

  <!-- Simple types -->

  <xs:simpleType name="Length">
    <xs:annotation><xs:documentation>Length with unit, such as 12pt, 20mm, 50%, or a reference to a length token such as $abstand-m.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="-?[0-9]+(\.[0-9]+)?(pt|mm|cm|in|pc|px|%)"/>
      <xs:pattern value="0"/>
      <xs:pattern value="$[A-Za-z_][A-Za-z0-9_.\-]*"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Lengths">
    <xs:annotation><xs:documentation>One to four lengths as in CSS (top, right, bottom, left), each also possible as a reference to a length token.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="(-?[0-9]+(\.[0-9]+)?(pt|mm|cm|in|pc|px|%)?|$[A-Za-z_][A-Za-z0-9_.\-]*)( (-?[0-9]+(\.[0-9]+)?(pt|mm|cm|in|pc|px|%)?|$[A-Za-z_][A-Za-z0-9_.\-]*)){0,3}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ColumnWidth">
    <xs:annotation><xs:documentation>Fixed length or proportion, such as 25mm or 2*.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]+(\.[0-9]+)?(pt|mm|cm|in|pc|px|%|\*)"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Color">
    <xs:annotation><xs:documentation>Color as #rgb, #rrggbb or name, or a reference to a color token such as $primaer.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?"/>
      <xs:pattern value="[a-z]+"/>
      <xs:pattern value="$[A-Za-z_][A-Za-z0-9_.\-]*"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TokenRef">
    <xs:annotation><xs:documentation>Reference to a token with a leading $.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="$[A-Za-z_][A-Za-z0-9_.\-]*"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="XPath">
    <xs:annotation><xs:documentation>XPath 3.1 expression, relative to the current context.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string"><xs:minLength value="1"/></xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Keep">
    <xs:restriction base="xs:string">
      <xs:pattern value="auto|always|[1-9][0-9]{0,2}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Break">
    <xs:restriction base="xs:token">
      <xs:enumeration value="auto"/>
      <xs:enumeration value="page"/>
      <xs:enumeration value="oddPage"/>
      <xs:enumeration value="evenPage"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Role">
    <xs:annotation><xs:documentation>Semantic role for Tagged PDF (PDF/A-3a, PDF/UA). It determines the structure type in the structure tree. Artifact removes the element from the structure tree (decoration, repetitions).</xs:documentation></xs:annotation>
    <xs:restriction base="xs:token">
      <xs:enumeration value="H1"/><xs:enumeration value="H2"/><xs:enumeration value="H3"/>
      <xs:enumeration value="H4"/><xs:enumeration value="H5"/><xs:enumeration value="H6"/>
      <xs:enumeration value="P"/><xs:enumeration value="Table"/><xs:enumeration value="Figure"/>
      <xs:enumeration value="List"/><xs:enumeration value="L"/><xs:enumeration value="LI"/>
      <xs:enumeration value="Lbl"/><xs:enumeration value="LBody"/>
      <xs:enumeration value="Note"/><xs:enumeration value="Artifact"/>
      <xs:enumeration value="Section"/><xs:enumeration value="Caption"/><xs:enumeration value="Link"/>
      <xs:enumeration value="Formula"/><xs:enumeration value="Reference"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ProfileList">
    <xs:annotation><xs:documentation>Conformance profiles separated by commas, such as pdfa-3a,pdfua-1.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="[a-z0-9.\-]+(,[a-z0-9.\-]+)*"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Attribute groups -->

  <xs:attributeGroup name="common">
    <xs:attribute name="id" type="xs:ID" use="required"/>
    <xs:attribute name="style" type="xs:IDREF"/>
    <xs:attribute name="presence" type="XPath">
      <xs:annotation><xs:documentation>The element appears only if the expression is true.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="role" type="Role"/>
    <xs:attribute name="alt" type="xs:string">
      <xs:annotation><xs:documentation>Alternative text for images, barcodes and figures. Mandatory for figures under PDF/A-3a and PDF/UA.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="altBind" type="XPath">
      <xs:annotation><xs:documentation>Alternative text from the data, such as amount and payee for the GiroCode. Takes precedence over alt.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="lang" type="xs:language">
      <xs:annotation><xs:documentation>Language of the content if it differs from the document language.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="readingOrder" type="xs:positiveInteger">
      <xs:annotation><xs:documentation>Position in the reading order among positioned siblings. If not specified, top to bottom and left to right applies.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="artifact" type="xs:boolean">
      <xs:annotation><xs:documentation>true removes the element from the structure tree as an artifact, such as decoration.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>

  <xs:attributeGroup name="placement">
    <xs:annotation><xs:documentation>Placement in a subform with layout="positioned".</xs:documentation></xs:annotation>
    <xs:attribute name="x" type="Length"/>
    <xs:attribute name="y" type="Length"/>
    <xs:attribute name="w" type="Length"/>
    <xs:attribute name="h" type="Length"/>
  </xs:attributeGroup>

  <xs:attributeGroup name="breaks">
    <xs:attribute name="breakBefore" type="Break"/>
    <xs:attribute name="breakAfter" type="Break"/>
    <xs:attribute name="keepTogether" type="Keep"/>
    <xs:attribute name="keepWithNext" type="Keep"/>
    <xs:attribute name="keepWithPrevious" type="Keep"/>
  </xs:attributeGroup>

  <xs:attributeGroup name="styleAttrs">
    <xs:attribute name="font" type="TokenRef">
      <xs:annotation><xs:documentation>Font token: sets family, size, weight and style as far as the token specifies them. Explicit attributes of the same element take precedence.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="fontFamily" type="xs:string"/>
    <xs:attribute name="fontSize" type="Length"/>
    <xs:attribute name="fontWeight">
      <xs:simpleType><xs:restriction base="xs:token">
        <xs:enumeration value="normal"/><xs:enumeration value="bold"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="fontStyle">
      <xs:simpleType><xs:restriction base="xs:token">
        <xs:enumeration value="normal"/><xs:enumeration value="italic"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="color" type="Color"/>
    <xs:attribute name="backgroundColor" type="Color"/>
    <xs:attribute name="textAlign">
      <xs:simpleType><xs:restriction base="xs:token">
        <xs:enumeration value="start"/><xs:enumeration value="center"/>
        <xs:enumeration value="end"/><xs:enumeration value="justify"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="lineHeight" type="xs:string"/>
    <xs:attribute name="spaceBefore" type="Length"/>
    <xs:attribute name="spaceAfter" type="Length"/>
    <xs:attribute name="padding" type="Lengths"/>
    <xs:attribute name="border" type="xs:string"/>
    <xs:attribute name="borderTop" type="xs:string"/>
    <xs:attribute name="borderBottom" type="xs:string"/>
    <xs:attribute name="borderLeft" type="xs:string"/>
    <xs:attribute name="borderRight" type="xs:string"/>
    <xs:attribute name="hyphenate" type="xs:boolean"/>
  </xs:attributeGroup>

  <!-- Root -->

  <xs:element name="template">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="namespaces" minOccurs="0"/>
        <xs:element ref="styles" minOccurs="0"/>
        <xs:element ref="tokens" minOccurs="0"/>
        <xs:element ref="formats" minOccurs="0"/>
        <xs:element ref="texts" minOccurs="0"/>
        <xs:element ref="pageSet"/>
        <xs:element ref="body"/>
        <xs:element ref="attachments" minOccurs="0"/>
        <xs:element ref="einvoice" minOccurs="0"/>
      </xs:sequence>
      <xs:attribute name="id" type="xs:ID" use="required"/>
      <xs:attribute name="version" type="xs:string" use="required" fixed="1"/>
      <xs:attribute name="profile" type="ProfileList">
        <xs:annotation><xs:documentation>Conformance profiles of the output, default pdfa-3b. A value given at invocation takes precedence.</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="lang" type="xs:language" use="required"/>
      <xs:attribute name="schema" type="xs:string">
        <xs:annotation><xs:documentation>Path of the data XSD in the template package, such as schema/cii.xsd.</xs:documentation></xs:annotation>
      </xs:attribute>
      <xs:attribute name="dataRoot">
        <xs:annotation><xs:documentation>Root element of the data with a prefix from namespaces. Not an xs:QName because the prefixes of the data are not bound in the XML of the template.</xs:documentation></xs:annotation>
        <xs:simpleType><xs:restriction base="xs:string">
          <xs:pattern value="([A-Za-z_][A-Za-z0-9_.\-]*:)?[A-Za-z_][A-Za-z0-9_.\-]*"/>
        </xs:restriction></xs:simpleType>
      </xs:attribute>
      <xs:attribute name="title" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="namespaces">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="ns" maxOccurs="unbounded">
          <xs:complexType>
            <xs:attribute name="prefix" type="xs:NCName" use="required"/>
            <xs:attribute name="uri" type="xs:anyURI" use="required"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- Resources -->

  <xs:element name="styles">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="style" maxOccurs="unbounded">
          <xs:complexType>
            <xs:attribute name="id" type="xs:ID" use="required"/>
            <xs:attribute name="parent" type="xs:IDREF"/>
            <xs:attributeGroup ref="styleAttrs"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="tokens">
    <xs:annotation><xs:documentation>Design tokens: named colors, lengths and fonts. Styles and elements refer to them with $id. A token may refer to another token of the same kind.</xs:documentation></xs:annotation>
    <xs:complexType>
      <xs:choice maxOccurs="unbounded">
        <xs:element name="color">
          <xs:complexType>
            <xs:attribute name="id" type="xs:ID" use="required"/>
            <xs:attribute name="value" type="Color" use="required"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="length">
          <xs:complexType>
            <xs:attribute name="id" type="xs:ID" use="required"/>
            <xs:attribute name="value" type="Length" use="required"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="font">
          <xs:complexType>
            <xs:attribute name="id" type="xs:ID" use="required"/>
            <xs:attribute name="family" type="xs:string"/>
            <xs:attribute name="size" type="Length"/>
            <xs:attribute name="weight">
              <xs:simpleType><xs:restriction base="xs:token">
                <xs:enumeration value="normal"/><xs:enumeration value="bold"/>
              </xs:restriction></xs:simpleType>
            </xs:attribute>
            <xs:attribute name="style">
              <xs:simpleType><xs:restriction base="xs:token">
                <xs:enumeration value="normal"/><xs:enumeration value="italic"/>
              </xs:restriction></xs:simpleType>
            </xs:attribute>
          </xs:complexType>
        </xs:element>
      </xs:choice>
    </xs:complexType>
  </xs:element>

  <xs:element name="formats">
    <xs:annotation><xs:documentation>Format patterns per locale for format-number and format-date.</xs:documentation></xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element name="locale" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="pattern" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:attribute name="id" type="xs:ID" use="required"/>
                  <xs:attribute name="name" type="xs:NCName" use="required"/>
                  <xs:attribute name="kind" use="required">
                    <xs:simpleType><xs:restriction base="xs:token">
                      <xs:enumeration value="number"/><xs:enumeration value="date"/><xs:enumeration value="dateTime"/>
                    </xs:restriction></xs:simpleType>
                  </xs:attribute>
                  <xs:attribute name="picture" type="xs:string" use="required"/>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
            <xs:attribute name="id" type="xs:ID" use="required"/>
            <xs:attribute name="lang" type="xs:language" use="required"/>
            <xs:attribute name="decimalSeparator" type="xs:string" default="."/>
            <xs:attribute name="groupingSeparator" type="xs:string" default=","/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="texts">
    <xs:annotation><xs:documentation>Text resources per language, referenced via text/@ref.</xs:documentation></xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element name="lang" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="string" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:simpleContent>
                    <xs:extension base="xs:string">
                      <xs:attribute name="id" type="xs:ID" use="required"/>
                      <xs:attribute name="key" type="xs:NCName" use="required"/>
                    </xs:extension>
                  </xs:simpleContent>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
            <xs:attribute name="id" type="xs:ID" use="required"/>
            <xs:attribute name="lang" type="xs:language" use="required"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- Page masters -->

  <xs:element name="pageSet">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="pageMaster" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="id" type="xs:ID" use="required"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="pageMaster">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="header" type="Region" minOccurs="0"/>
        <xs:element name="footer" type="Region" minOccurs="0"/>
      </xs:sequence>
      <xs:attribute name="id" type="xs:ID" use="required"/>
      <xs:attribute name="use" default="any">
        <xs:annotation><xs:documentation>The pages to which the page master applies, checked in the order only, first, last, odd, even, rest, any. rest is every page except the first, including the last.</xs:documentation></xs:annotation>
        <xs:simpleType><xs:restriction base="xs:token">
          <xs:enumeration value="first"/><xs:enumeration value="rest"/><xs:enumeration value="last"/>
          <xs:enumeration value="only"/><xs:enumeration value="odd"/><xs:enumeration value="even"/>
          <xs:enumeration value="any"/>
        </xs:restriction></xs:simpleType>
      </xs:attribute>
      <xs:attribute name="size" default="A4">
        <xs:simpleType><xs:restriction base="xs:token">
          <xs:enumeration value="A4"/><xs:enumeration value="A5"/><xs:enumeration value="A3"/>
          <xs:enumeration value="Letter"/><xs:enumeration value="Legal"/><xs:enumeration value="custom"/>
        </xs:restriction></xs:simpleType>
      </xs:attribute>
      <xs:attribute name="orientation" default="portrait">
        <xs:simpleType><xs:restriction base="xs:token">
          <xs:enumeration value="portrait"/><xs:enumeration value="landscape"/>
        </xs:restriction></xs:simpleType>
      </xs:attribute>
      <xs:attribute name="width" type="Length"/>
      <xs:attribute name="height" type="Length"/>
      <xs:attribute name="margin" type="Lengths" default="20mm"/>
    </xs:complexType>
  </xs:element>

  <xs:complexType name="Region">
    <xs:annotation><xs:documentation>Header or footer of a page master. Content is positioned, placement relative to the region.</xs:documentation></xs:annotation>
    <xs:group ref="content" minOccurs="0" maxOccurs="unbounded"/>
    <xs:attribute name="id" type="xs:ID" use="required"/>
    <xs:attribute name="height" type="Length" use="required"/>
    <xs:attribute name="gap" type="Length" default="5mm"/>
  </xs:complexType>

  <!-- Content -->

  <xs:element name="body">
    <xs:complexType>
      <xs:group ref="content" minOccurs="0" maxOccurs="unbounded"/>
      <xs:attribute name="id" type="xs:ID" use="required"/>
      <xs:attributeGroup ref="styleAttrs"/>
      <xs:attribute name="style" type="xs:IDREF"/>
    </xs:complexType>
  </xs:element>

  <xs:group name="content">
    <xs:choice>
      <xs:element ref="subform"/>
      <xs:element ref="text"/>
      <xs:element ref="field"/>
      <xs:element ref="image"/>
      <xs:element ref="line"/>
      <xs:element ref="rect"/>
      <xs:element ref="barcode"/>
      <xs:element ref="pageNumber"/>
      <xs:element ref="table"/>
      <xs:element ref="textField"/>
      <xs:element ref="checkBox"/>
      <xs:element ref="radioGroup"/>
      <xs:element ref="listBox"/>
      <xs:element ref="comboBox"/>
      <xs:element ref="signatureField"/>
    </xs:choice>
  </xs:group>

  <xs:element name="subform">
    <xs:annotation><xs:documentation>Subform. positioned: children with x and y. flowed: children stacked vertically. With bind and repeat="true" it is repeated per data node.</xs:documentation></xs:annotation>
    <xs:complexType>
      <xs:group ref="content" minOccurs="0" maxOccurs="unbounded"/>
      <xs:attributeGroup ref="common"/>
      <xs:attributeGroup ref="placement"/>
      <xs:attributeGroup ref="breaks"/>
      <xs:attributeGroup ref="styleAttrs"/>
      <xs:attribute name="layout" use="required">
        <xs:simpleType><xs:restriction base="xs:token">
          <xs:enumeration value="positioned"/><xs:enumeration value="flowed"/>
        </xs:restriction></xs:simpleType>
      </xs:attribute>
      <xs:attribute name="bind" type="XPath"/>
      <xs:attribute name="repeat" type="xs:boolean" default="false"/>
      <xs:attribute name="anchor" default="flow">
        <xs:annotation><xs:documentation>page: x and y refer to the page (such as an address window), flow: to the flow.</xs:documentation></xs:annotation>
        <xs:simpleType><xs:restriction base="xs:token">
          <xs:enumeration value="flow"/><xs:enumeration value="page"/>
        </xs:restriction></xs:simpleType>
      </xs:attribute>
    </xs:complexType>
  </xs:element>

  <xs:element name="text">
    <xs:annotation><xs:documentation>Text, static or rich text with span and embedded fields. Alternatively ref to a text resource.</xs:documentation></xs:annotation>
    <xs:complexType mixed="true">
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="span"/>
        <xs:element ref="field"/>
        <xs:element ref="pageNumber"/>
        <xs:element name="br">
          <xs:complexType><xs:attribute name="id" type="xs:ID" use="required"/></xs:complexType>
        </xs:element>
      </xs:choice>
      <xs:attributeGroup ref="common"/>
      <xs:attributeGroup ref="placement"/>
      <xs:attributeGroup ref="breaks"/>
      <xs:attributeGroup ref="styleAttrs"/>
      <xs:attribute name="ref" type="xs:NCName"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="span">
    <xs:complexType mixed="true">
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="span"/>
        <xs:element ref="field"/>
      </xs:choice>
      <xs:attributeGroup ref="common"/>
      <xs:attributeGroup ref="styleAttrs"/>
      <xs:attribute name="href" type="xs:anyURI"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="field">
    <xs:annotation><xs:documentation>Bound value. format refers to a pattern from formats.</xs:documentation></xs:annotation>
    <xs:complexType>
      <xs:attributeGroup ref="common"/>
      <xs:attributeGroup ref="placement"/>
      <xs:attributeGroup ref="styleAttrs"/>
      <xs:attribute name="bind" type="XPath" use="required"/>
      <xs:attribute name="format" type="xs:NCName"/>
      <xs:attribute name="default" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="image">
    <xs:complexType>
      <xs:attributeGroup ref="common"/>
      <xs:attributeGroup ref="placement"/>
      <xs:attribute name="src" type="xs:string" use="required">
        <xs:annotation><xs:documentation>Path in the template package, such as assets/logo.png.</xs:documentation></xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>

  <xs:element name="line">
    <xs:complexType>
      <xs:attributeGroup ref="common"/>
      <xs:attributeGroup ref="placement"/>
      <xs:attribute name="thickness" type="Length" default="0.5pt"/>
      <xs:attribute name="color" type="Color"/>
      <xs:attribute name="lineStyle" default="solid">
        <xs:simpleType><xs:restriction base="xs:token">
          <xs:enumeration value="solid"/><xs:enumeration value="dashed"/><xs:enumeration value="dotted"/>
        </xs:restriction></xs:simpleType>
      </xs:attribute>
    </xs:complexType>
  </xs:element>

  <xs:element name="rect">
    <xs:complexType>
      <xs:attributeGroup ref="common"/>
      <xs:attributeGroup ref="placement"/>
      <xs:attribute name="fill" type="Color"/>
      <xs:attribute name="border" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="barcode">
    <xs:annotation><xs:documentation>Barcode. Values as a literal (value) or binding (bind), for the GiroCode via data elements.</xs:documentation></xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element name="data" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:attribute name="id" type="xs:ID" use="required"/>
            <xs:attribute name="name" use="required">
              <xs:simpleType><xs:restriction base="xs:token">
                <xs:enumeration value="name"/><xs:enumeration value="iban"/><xs:enumeration value="bic"/>
                <xs:enumeration value="amount"/><xs:enumeration value="purpose"/>
                <xs:enumeration value="reference"/><xs:enumeration value="text"/>
              </xs:restriction></xs:simpleType>
            </xs:attribute>
            <xs:attribute name="value" type="xs:string"/>
            <xs:attribute name="bind" type="XPath"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attributeGroup ref="common"/>
      <xs:attributeGroup ref="placement"/>
      <xs:attribute name="type" use="required">
        <xs:simpleType><xs:restriction base="xs:token">
          <xs:enumeration value="qr"/><xs:enumeration value="datamatrix"/>
          <xs:enumeration value="code128"/><xs:enumeration value="girocode"/>
        </xs:restriction></xs:simpleType>
      </xs:attribute>
      <xs:attribute name="value" type="xs:string"/>
      <xs:attribute name="bind" type="XPath"/>
      <xs:attribute name="moduleWidth" type="Length"/>
      <xs:attribute name="barHeight" type="Length"/>
    </xs:complexType>
  </xs:element>

  <!-- Form fields (AcroForm) -->

  <xs:attributeGroup name="formField">
    <xs:attribute name="bind" type="XPath" use="required">
      <xs:annotation><xs:documentation>Data node of the field. It prefills the field and receives the input on extraction (pdx extract-data), therefore only a simple path of child steps.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="label" type="xs:string">
      <xs:annotation><xs:documentation>Accessible name of the field that screen readers announce (TU). Mandatory under PDF/A-3a and PDF/UA.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="readOnly" type="xs:boolean" default="false"/>
    <xs:attribute name="required" type="xs:boolean" default="false"/>
  </xs:attributeGroup>

  <xs:element name="option">
    <xs:annotation><xs:documentation>Choice value of a radio button or a list. Without option elements the values of the enumeration in the data XSD apply.</xs:documentation></xs:annotation>
    <xs:complexType>
      <xs:attribute name="id" type="xs:ID" use="required"/>
      <xs:attribute name="value" type="xs:string" use="required"/>
      <xs:attribute name="label" type="xs:string">
        <xs:annotation><xs:documentation>Displayed text, the value if not specified.</xs:documentation></xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>

  <xs:element name="textField">
    <xs:annotation><xs:documentation>Text field to fill in, single-line or multiline.</xs:documentation></xs:annotation>
    <xs:complexType>
      <xs:attributeGroup ref="common"/>
      <xs:attributeGroup ref="placement"/>
      <xs:attributeGroup ref="styleAttrs"/>
      <xs:attributeGroup ref="formField"/>
      <xs:attribute name="multiline" type="xs:boolean" default="false"/>
      <xs:attribute name="maxLength" type="xs:positiveInteger"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="checkBox">
    <xs:annotation><xs:documentation>Check box. When checked it writes onValue into the data, otherwise offValue.</xs:documentation></xs:annotation>
    <xs:complexType>
      <xs:attributeGroup ref="common"/>
      <xs:attributeGroup ref="placement"/>
      <xs:attributeGroup ref="styleAttrs"/>
      <xs:attributeGroup ref="formField"/>
      <xs:attribute name="onValue" type="xs:string" default="true"/>
      <xs:attribute name="offValue" type="xs:string" default="false"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="radioGroup">
    <xs:annotation><xs:documentation>Radio button group, exactly one value selectable. Each option is on its own line with its text.</xs:documentation></xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="option" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attributeGroup ref="common"/>
      <xs:attributeGroup ref="placement"/>
      <xs:attributeGroup ref="styleAttrs"/>
      <xs:attributeGroup ref="formField"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="listBox">
    <xs:annotation><xs:documentation>Selection list with visible entries.</xs:documentation></xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="option" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attributeGroup ref="common"/>
      <xs:attributeGroup ref="placement"/>
      <xs:attributeGroup ref="styleAttrs"/>
      <xs:attributeGroup ref="formField"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="comboBox">
    <xs:annotation><xs:documentation>Combo box: selection from a drop-down list, with editable="true" also free input.</xs:documentation></xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="option" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attributeGroup ref="common"/>
      <xs:attributeGroup ref="placement"/>
      <xs:attributeGroup ref="styleAttrs"/>
      <xs:attributeGroup ref="formField"/>
      <xs:attribute name="editable" type="xs:boolean" default="false"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="signatureField">
    <xs:annotation><xs:documentation>Unsigned signature field. pdx sign can sign it later.</xs:documentation></xs:annotation>
    <xs:complexType>
      <xs:attributeGroup ref="common"/>
      <xs:attributeGroup ref="placement"/>
      <xs:attribute name="label" type="xs:string">
        <xs:annotation><xs:documentation>Accessible name of the field. Mandatory under PDF/A-3a and PDF/UA.</xs:documentation></xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>

  <xs:element name="pageNumber">
    <xs:annotation><xs:documentation>Page counter. pattern with the placeholders {current} and {total}, such as "Page {current} of {total}".</xs:documentation></xs:annotation>
    <xs:complexType>
      <xs:attributeGroup ref="common"/>
      <xs:attributeGroup ref="placement"/>
      <xs:attributeGroup ref="styleAttrs"/>
      <xs:attribute name="pattern" type="xs:string" default="{current}"/>
    </xs:complexType>
  </xs:element>

  <!-- Tables -->

  <xs:element name="table">
    <xs:annotation><xs:documentation>Table. The rows in rows are repeated per data node from bind. header and footer appear on every page with repeat="true".</xs:documentation></xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element name="column" maxOccurs="unbounded">
          <xs:complexType>
            <xs:attribute name="id" type="xs:ID" use="required"/>
            <xs:attribute name="width" type="ColumnWidth" default="1*"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="header" type="TableSection" minOccurs="0"/>
        <xs:element name="group" minOccurs="0">
          <xs:annotation><xs:documentation>Grouping of the data nodes by by, with header and footer rows per group.</xs:documentation></xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element name="header" type="TableSection" minOccurs="0"/>
              <xs:element name="footer" type="TableSection" minOccurs="0"/>
            </xs:sequence>
            <xs:attribute name="id" type="xs:ID" use="required"/>
            <xs:attribute name="by" type="XPath" use="required"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="rows" type="TableSection"/>
        <xs:element name="footer" type="TableSection" minOccurs="0"/>
      </xs:sequence>
      <xs:attributeGroup ref="common"/>
      <xs:attributeGroup ref="breaks"/>
      <xs:attributeGroup ref="styleAttrs"/>
      <xs:attribute name="bind" type="XPath" use="required"/>
      <xs:attribute name="width" type="Length"/>
      <xs:attribute name="borders" default="collapse">
        <xs:simpleType><xs:restriction base="xs:token">
          <xs:enumeration value="collapse"/><xs:enumeration value="separate"/>
        </xs:restriction></xs:simpleType>
      </xs:attribute>
    </xs:complexType>
  </xs:element>

  <xs:complexType name="TableSection">
    <xs:sequence>
      <xs:element name="row" maxOccurs="unbounded">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="cell" maxOccurs="unbounded">
              <xs:complexType>
                <xs:choice minOccurs="0" maxOccurs="unbounded">
                  <xs:group ref="content"/>
                  <xs:element ref="subtotal"/>
                  <xs:element ref="carryOver"/>
                  <xs:element ref="total"/>
                </xs:choice>
                <xs:attributeGroup ref="common"/>
                <xs:attributeGroup ref="styleAttrs"/>
                <xs:attribute name="colspan" type="xs:positiveInteger" default="1"/>
                <xs:attribute name="scope">
                  <xs:annotation><xs:documentation>Scope of a header cell: Column (column header, default in the table header), Row (row header) or Both.</xs:documentation></xs:annotation>
                  <xs:simpleType><xs:restriction base="xs:token">
                    <xs:enumeration value="Column"/><xs:enumeration value="Row"/><xs:enumeration value="Both"/>
                  </xs:restriction></xs:simpleType>
                </xs:attribute>
                <xs:attribute name="rowspan" type="xs:positiveInteger" default="1"/>
                <xs:attribute name="verticalAlign" default="top">
                  <xs:simpleType><xs:restriction base="xs:token">
                    <xs:enumeration value="top"/><xs:enumeration value="middle"/><xs:enumeration value="bottom"/>
                  </xs:restriction></xs:simpleType>
                </xs:attribute>
              </xs:complexType>
            </xs:element>
          </xs:sequence>
          <xs:attributeGroup ref="common"/>
          <xs:attributeGroup ref="breaks"/>
          <xs:attributeGroup ref="styleAttrs"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="id" type="xs:ID" use="required"/>
    <xs:attribute name="repeat" type="xs:boolean" default="true"/>
  </xs:complexType>

  <xs:attributeGroup name="sum">
    <xs:attribute name="id" type="xs:ID" use="required"/>
    <xs:attribute name="of" type="XPath" use="required">
      <xs:annotation><xs:documentation>Amount per data node of the table, relative to the node.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="format" type="xs:NCName"/>
    <xs:attribute name="style" type="xs:IDREF"/>
  </xs:attributeGroup>

  <xs:element name="subtotal">
    <xs:annotation><xs:documentation>Subtotal up to the last row of the page (in the table footer).</xs:documentation></xs:annotation>
    <xs:complexType><xs:attributeGroup ref="sum"/></xs:complexType>
  </xs:element>

  <xs:element name="carryOver">
    <xs:annotation><xs:documentation>Carry-over from the previous pages (in the table header).</xs:documentation></xs:annotation>
    <xs:complexType><xs:attributeGroup ref="sum"/></xs:complexType>
  </xs:element>

  <xs:element name="total">
    <xs:annotation><xs:documentation>Total over all data nodes of the table.</xs:documentation></xs:annotation>
    <xs:complexType><xs:attributeGroup ref="sum"/></xs:complexType>
  </xs:element>

  <!-- E-invoice -->

  <xs:element name="einvoice">
    <xs:annotation><xs:documentation>Hybrid invoice according to Factur-X and ZUGFeRD: the data (CII) is embedded as factur-x.xml. The conformance level is derived from the guideline ID of the data.</xs:documentation></xs:annotation>
    <xs:complexType>
      <xs:attribute name="id" type="xs:ID" use="required"/>
      <xs:attribute name="afRelationship">
        <xs:annotation><xs:documentation>Relationship of the XML to the PDF. If not specified, Data for MINIMUM and BASIC WL, otherwise Alternative.</xs:documentation></xs:annotation>
        <xs:simpleType><xs:restriction base="xs:token">
          <xs:enumeration value="Data"/><xs:enumeration value="Alternative"/><xs:enumeration value="Source"/>
        </xs:restriction></xs:simpleType>
      </xs:attribute>
    </xs:complexType>
  </xs:element>

  <!-- Attachments -->

  <xs:element name="attachments">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="attachment" maxOccurs="unbounded">
          <xs:complexType>
            <xs:attribute name="id" type="xs:ID" use="required"/>
            <xs:attribute name="name" type="xs:string" use="required"/>
            <xs:attribute name="source" use="required">
              <xs:annotation><xs:documentation>data: the input data itself (such as factur-x.xml), otherwise a path in the template package.</xs:documentation></xs:annotation>
              <xs:simpleType><xs:restriction base="xs:string"/></xs:simpleType>
            </xs:attribute>
            <xs:attribute name="mimeType" type="xs:string" use="required"/>
            <xs:attribute name="relationship" default="Unspecified">
              <xs:simpleType><xs:restriction base="xs:token">
                <xs:enumeration value="Source"/><xs:enumeration value="Data"/><xs:enumeration value="Alternative"/>
                <xs:enumeration value="Supplement"/><xs:enumeration value="Unspecified"/>
              </xs:restriction></xs:simpleType>
            </xs:attribute>
            <xs:attribute name="description" type="xs:string"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
