# Textdateien überall mit LF auschecken, auch unter Windows. Eingebettete
# Dateien (Lizenzen, Schemas, Trennmuster) und Golden Files müssen auf allen
# Systemen dieselben Bytes haben.
* text=auto eol=lf

*.ttf binary
*.otf binary
*.pdf binary
*.png binary
*.jpg binary
*.icc binary
*.zip binary

# Batch-Dateien brauchen unter Windows CRLF.
*.cmd text eol=crlf

# PowerShell unter Windows mit CRLF.
*.ps1 text eol=crlf
