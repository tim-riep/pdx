# Check out text files with LF everywhere, including Windows. Embedded
# files (licenses, schemas, hyphenation patterns) and golden files must have
# the same bytes on all systems.
* text=auto eol=lf

*.ttf binary
*.otf binary
*.pdf binary
*.png binary
*.jpg binary
*.icc binary
*.zip binary

# Batch files need CRLF on Windows.
*.cmd text eol=crlf

# PowerShell on Windows with CRLF.
*.ps1 text eol=crlf

# Inno Setup on Windows with CRLF.
*.iss text eol=crlf
