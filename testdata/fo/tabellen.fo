<fo:root xmlns:fo="http://www.w3.org/1999/XSL/Format" xmlns:pdx="https://github.com/tim-riep/pdx/ns/fo/1" xml:lang="de-DE">
  <fo:layout-master-set>
    <fo:simple-page-master master-name="A4" page-width="210mm" page-height="297mm" margin="15mm 20mm">
      <fo:region-body margin-bottom="12mm"/>
      <fo:region-after extent="8mm"/>
    </fo:simple-page-master>
  </fo:layout-master-set>
  <fo:declarations>
    <pdx:metadata title="Tabellen und Listen" subject="Korpus: Tabellen und Listen"/>
  </fo:declarations>
  <fo:page-sequence master-reference="A4" font-family="Helvetica" font-size="9.5pt">
