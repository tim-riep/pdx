<?xml version="1.0" encoding="UTF-8"?>
<!-- Kopf und Fuß mit Logo, Hintergrund, Rahmen und Seitenzahl ab Seite 5. -->
<fo:root xmlns:fo="http://www.w3.org/1999/XSL/Format" xmlns:pdx="urn:pdx:extensions" xml:lang="de-DE">
  <fo:layout-master-set>
    <fo:simple-page-master master-name="A4" page-width="210mm" page-height="297mm" margin="10mm 15mm">
      <fo:region-body margin-top="30mm" margin-bottom="22mm"/>
      <fo:region-before extent="25mm" region-name="kopf"/>
      <fo:region-after extent="18mm" region-name="fuss"/>
    </fo:simple-page-master>
  </fo:layout-master-set>
  <fo:declarations>
    <pdx:metadata title="Kopf und Fuß" subject="Korpus: Kopf- und Fußbereiche"/>
  </fo:declarations>
  <fo:page-sequence master-reference="A4" initial-page-number="5" font-family="Helvetica" font-size="10pt">
    <fo:static-content flow-name="kopf">
      <fo:block background-color="#1f4e79" color="white" padding="3mm 4mm" font-size="14pt" font-weight="bold">
        <fo:external-graphic src="url('../images/logo-alpha.png')" content-height="8mm"/> Beispiel GmbH
      </fo:block>
      <fo:block font-size="8pt" color="#1f4e79" text-align="end" space-before="1mm">Interne Mitteilung</fo:block>
    </fo:static-content>
    <fo:static-content flow-name="fuss">
      <fo:block border-top="1pt solid #1f4e79" padding-top="2mm" font-size="8pt" text-align="center">Beispiel GmbH · Hauptstraße 1 · 50667 Köln · Seite <fo:page-number/></fo:block>
      <fo:block font-size="7pt" color="#777777" text-align="center" space-before="1mm">Amtsgericht Köln HRB 00000 · Geschäftsführung Erika Musterfrau</fo:block>
    </fo:static-content>
    <fo:flow flow-name="xsl-region-body">
      <fo:block font-size="16pt" font-weight="bold" space-after="6mm">Kopf- und Fußbereiche</fo:block>
      <fo:block space-after="4mm">Diese Seiten zeigen statische Inhalte mit Hintergrundfarbe, Rahmen, Logo und Seitenzahl. Die Zählung beginnt bei fünf. Der Fluss erzwingt mit Zeilenumbrüchen eine zweite Seite.</fo:block>
      <fo:block linefeed-treatment="preserve" font-family="monospace" font-size="9pt" background-color="#f2f2f2" padding="2mm" border="0.5pt dashed #999999">Zeile eins
Zeile zwei

Zeile vier nach einer Leerzeile</fo:block>
      <fo:block space-before="200mm">Dieser Block steht wegen seines Abstands auf der zweiten Seite. Am Seitenanfang wird space-before verworfen.</fo:block>
    </fo:flow>
  </fo:page-sequence>
</fo:root>
