{
  "openapi": "3.1.0",
  "info": {
    "title": "pdx render service",
    "version": "1",
    "description": "Renders templates to PDF up to PDF/A and PDF/UA, checks with veraPDF and signs according to PAdES. No payload data in logs or metrics, nothing is stored beyond the request except templates.",
    "license": {"name": "Apache-2.0", "identifier": "Apache-2.0"}
  },
  "servers": [{"url": "/"}],
  "security": [{"bearer": []}, {"apiKey": []}],
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Liveness",
        "security": [],
        "responses": {"200": {"description": "Service is running", "content": {"text/plain": {"schema": {"type": "string"}}}}}
      }
    },
    "/readyz": {
      "get": {
        "summary": "Readiness, store readable",
        "security": [],
        "responses": {
          "200": {"description": "ready", "content": {"text/plain": {"schema": {"type": "string"}}}},
          "503": {"$ref": "#/components/responses/Problem"}
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Metrics in the Prometheus text format",
        "security": [],
        "responses": {"200": {"description": "Metrics", "content": {"text/plain": {"schema": {"type": "string"}}}}}
      }
    },
    "/openapi.json": {
      "get": {
        "summary": "This specification",
        "security": [],
        "responses": {"200": {"description": "OpenAPI 3.1", "content": {"application/json": {"schema": {"type": "object"}}}}}
      }
    },
    "/v1/render/{id}": {
      "post": {
        "summary": "Render a record",
        "description": "Permission render. Data XML in the body, PDF as response.",
        "parameters": [
          {"$ref": "#/components/parameters/id"},
          {"$ref": "#/components/parameters/version"},
          {"$ref": "#/components/parameters/profile"},
          {"$ref": "#/components/parameters/lang"},
          {"$ref": "#/components/parameters/strict"},
          {"$ref": "#/components/parameters/creationDate"}
        ],
        "requestBody": {"required": true, "content": {"application/xml": {"schema": {"type": "string"}}}},
        "responses": {
          "200": {"description": "PDF", "headers": {"X-Pdx-Template-Version": {"$ref": "#/components/headers/version"}},
                  "content": {"application/pdf": {"schema": {"type": "string", "format": "binary"}}}},
          "400": {"$ref": "#/components/responses/Problem"},
          "401": {"$ref": "#/components/responses/Problem"},
          "403": {"$ref": "#/components/responses/Problem"},
          "404": {"$ref": "#/components/responses/Problem"},
          "413": {"$ref": "#/components/responses/Problem"},
          "422": {"$ref": "#/components/responses/Problem"},
          "503": {"$ref": "#/components/responses/Problem"},
          "504": {"$ref": "#/components/responses/Problem"}
        }
      }
    },
    "/v1/render/{id}/batch": {
      "post": {
        "summary": "Render a batch",
        "description": "Permission render. ZIP with XML files in the body, ZIP with one PDF per record and ergebnis.json as response. Errors of individual records are in ergebnis.json.",
        "parameters": [
          {"$ref": "#/components/parameters/id"},
          {"$ref": "#/components/parameters/version"},
          {"$ref": "#/components/parameters/profile"},
          {"$ref": "#/components/parameters/lang"},
          {"$ref": "#/components/parameters/strict"},
          {"$ref": "#/components/parameters/creationDate"}
        ],
        "requestBody": {"required": true, "content": {"application/zip": {"schema": {"type": "string", "format": "binary"}}}},
        "responses": {
          "200": {"description": "ZIP", "headers": {"X-Pdx-Template-Version": {"$ref": "#/components/headers/version"}},
                  "content": {"application/zip": {"schema": {"type": "string", "format": "binary"}}}},
          "400": {"$ref": "#/components/responses/Problem"},
          "401": {"$ref": "#/components/responses/Problem"},
          "403": {"$ref": "#/components/responses/Problem"},
          "404": {"$ref": "#/components/responses/Problem"},
          "413": {"$ref": "#/components/responses/Problem"},
          "422": {"$ref": "#/components/responses/Problem"},
          "503": {"$ref": "#/components/responses/Problem"}
        }
      }
    },
    "/v1/templates": {
      "get": {
        "summary": "List templates",
        "description": "Permission templates.",
        "responses": {
          "200": {"description": "Templates", "content": {"application/json": {"schema": {
            "type": "object", "required": ["templates"],
            "properties": {"templates": {"type": "array", "items": {"$ref": "#/components/schemas/TemplateInfo"}}}}}}},
          "401": {"$ref": "#/components/responses/Problem"},
          "403": {"$ref": "#/components/responses/Problem"}
        }
      }
    },
    "/v1/templates/{id}": {
      "post": {
        "summary": "Store a template package as a new version",
        "description": "Permission templates. The package is read and compiled, a faulty template is rejected with all findings. The same content as an existing version returns that version with 200.",
        "parameters": [
          {"$ref": "#/components/parameters/id"},
          {"name": "activate", "in": "query", "schema": {"type": "boolean"}, "description": "Activate the version immediately"}
        ],
        "requestBody": {"required": true, "content": {"application/zip": {"schema": {"type": "string", "format": "binary"}}}},
        "responses": {
          "200": {"$ref": "#/components/responses/Version"},
          "201": {"$ref": "#/components/responses/Version"},
          "400": {"$ref": "#/components/responses/Problem"},
          "401": {"$ref": "#/components/responses/Problem"},
          "403": {"$ref": "#/components/responses/Problem"},
          "413": {"$ref": "#/components/responses/Problem"},
          "422": {"$ref": "#/components/responses/Problem"},
          "503": {"$ref": "#/components/responses/Problem"}
        }
      }
    },
    "/v1/templates/{id}/versions": {
      "get": {
        "summary": "Versions of a template",
        "description": "Permission templates.",
        "parameters": [{"$ref": "#/components/parameters/id"}],
        "responses": {
          "200": {"description": "Versions", "content": {"application/json": {"schema": {
            "type": "object", "required": ["id", "versions"],
            "properties": {"id": {"type": "string"}, "versions": {"type": "array", "items": {"$ref": "#/components/schemas/Version"}}}}}}},
          "401": {"$ref": "#/components/responses/Problem"},
          "403": {"$ref": "#/components/responses/Problem"},
          "404": {"$ref": "#/components/responses/Problem"}
        }
      }
    },
    "/v1/templates/{id}/versions/{version}": {
      "get": {
        "summary": "Package of a version",
        "description": "Permission templates. For the comparison in the designer.",
        "parameters": [{"$ref": "#/components/parameters/id"}, {"name": "version", "in": "path", "required": true, "schema": {"type": "string"}}],
        "responses": {
          "200": {"description": "ZIP", "headers": {"X-Pdx-Template-Version": {"$ref": "#/components/headers/version"}, "ETag": {"schema": {"type": "string"}}},
                  "content": {"application/zip": {"schema": {"type": "string", "format": "binary"}}}},
          "401": {"$ref": "#/components/responses/Problem"},
          "403": {"$ref": "#/components/responses/Problem"},
          "404": {"$ref": "#/components/responses/Problem"}
        }
      }
    },
    "/v1/templates/{id}/active": {
      "put": {
        "summary": "Activate a version",
        "description": "Permission templates.",
        "parameters": [{"$ref": "#/components/parameters/id"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {
          "type": "object", "required": ["version"], "properties": {"version": {"type": "string"}}}}}},
        "responses": {
          "200": {"description": "activated", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TemplateInfo"}}}},
          "400": {"$ref": "#/components/responses/Problem"},
          "401": {"$ref": "#/components/responses/Problem"},
          "403": {"$ref": "#/components/responses/Problem"},
          "404": {"$ref": "#/components/responses/Problem"}
        }
      }
    },
    "/v1/verify": {
      "post": {
        "summary": "Check a PDF with veraPDF",
        "description": "Permission verify. 501 if veraPDF is not configured.",
        "parameters": [{"$ref": "#/components/parameters/profile"}],
        "requestBody": {"required": true, "content": {"application/pdf": {"schema": {"type": "string", "format": "binary"}}}},
        "responses": {
          "200": {"description": "Result", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/VerifyResult"}}}},
          "400": {"$ref": "#/components/responses/Problem"},
          "401": {"$ref": "#/components/responses/Problem"},
          "403": {"$ref": "#/components/responses/Problem"},
          "413": {"$ref": "#/components/responses/Problem"},
          "501": {"$ref": "#/components/responses/Problem"},
          "502": {"$ref": "#/components/responses/Problem"},
          "503": {"$ref": "#/components/responses/Problem"}
        }
      }
    },
    "/v1/sign": {
      "post": {
        "summary": "Sign a PDF according to PAdES",
        "description": "Permission sign. Signs by incremental update with the key of the service. 501 if no signer is configured.",
        "parameters": [
          {"name": "level", "in": "query", "schema": {"type": "string", "enum": ["B-B", "B-T", "B-LT", "B-LTA"]}},
          {"name": "field", "in": "query", "schema": {"type": "string"}, "description": "existing signature field, otherwise invisible"},
          {"name": "reason", "in": "query", "schema": {"type": "string"}},
          {"name": "location", "in": "query", "schema": {"type": "string"}}
        ],
        "requestBody": {"required": true, "content": {"application/pdf": {"schema": {"type": "string", "format": "binary"}}}},
        "responses": {
          "200": {"description": "signed PDF", "content": {"application/pdf": {"schema": {"type": "string", "format": "binary"}}}},
          "401": {"$ref": "#/components/responses/Problem"},
          "403": {"$ref": "#/components/responses/Problem"},
          "413": {"$ref": "#/components/responses/Problem"},
          "422": {"$ref": "#/components/responses/Problem"},
          "501": {"$ref": "#/components/responses/Problem"},
          "503": {"$ref": "#/components/responses/Problem"},
          "504": {"$ref": "#/components/responses/Problem"}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {"type": "http", "scheme": "bearer"},
      "apiKey": {"type": "apiKey", "in": "header", "name": "X-API-Key"}
    },
    "parameters": {
      "id": {"name": "id", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"}},
      "version": {"name": "version", "in": "query", "schema": {"type": "string"}, "description": "Version, the active one if omitted"},
      "profile": {"name": "profile", "in": "query", "schema": {"type": "string"}, "description": "Comma-separated profiles, for example pdfa-3a,pdfua-1"},
      "lang": {"name": "lang", "in": "query", "schema": {"type": "string"}},
      "strict": {"name": "strict", "in": "query", "schema": {"type": "boolean"}, "description": "Validate the data against the data XSD"},
      "creationDate": {"name": "creationDate", "in": "query", "schema": {"type": "string", "format": "date-time"}, "description": "Creation date, the same input yields the same bytes"}
    },
    "headers": {
      "version": {"schema": {"type": "string"}, "description": "version of the template used"}
    },
    "responses": {
      "Problem": {"description": "Error according to RFC 9457", "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/Problem"}}}},
      "Version": {"description": "Version", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Version"}}}}
    },
    "schemas": {
      "Problem": {
        "type": "object", "required": ["type", "title", "status"],
        "properties": {
          "type": {"type": "string"}, "title": {"type": "string"}, "status": {"type": "integer"},
          "detail": {"type": "string"},
          "findings": {"type": "array", "items": {"$ref": "#/components/schemas/Finding"}}
        }
      },
      "Finding": {
        "type": "object", "required": ["message"],
        "properties": {"id": {"type": "string"}, "line": {"type": "integer"}, "col": {"type": "integer"}, "message": {"type": "string"}}
      },
      "TemplateInfo": {
        "type": "object", "required": ["id"],
        "properties": {"id": {"type": "string"}, "active": {"type": "string"}}
      },
      "Version": {
        "type": "object", "required": ["version", "sha256", "size", "created", "active"],
        "properties": {
          "version": {"type": "string"}, "sha256": {"type": "string"}, "size": {"type": "integer"},
          "created": {"type": "string", "format": "date-time"}, "active": {"type": "boolean"}
        }
      },
      "VerifyResult": {
        "type": "object", "required": ["konform", "berichte"],
        "properties": {
          "konform": {"type": "boolean"},
          "berichte": {"type": "array", "items": {
            "type": "object", "required": ["profil", "konform"],
            "properties": {
              "profil": {"type": "string"}, "konform": {"type": "boolean"}, "ausnahme": {"type": "string"},
              "befunde": {"type": "array", "items": {
                "type": "object", "required": ["spezifikation", "klausel", "test", "beschreibung", "fehlschlaege"],
                "properties": {"spezifikation": {"type": "string"}, "klausel": {"type": "string"}, "test": {"type": "string"},
                  "beschreibung": {"type": "string"}, "fehlschlaege": {"type": "integer"}}}}
            }}}
        }
      }
    }
  }
}
